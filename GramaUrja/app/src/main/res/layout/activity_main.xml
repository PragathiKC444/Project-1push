<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="top"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/zone_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone: Village Main"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_change_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Change Zone"
            android:textSize="12sp"
            android:padding="8dp" />
    </FrameLayout>

    <!-- Power Status Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/status_box_bg"
        android:id="@+id/status_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Power Status"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/status_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/power_off_text" />
        </LinearLayout>
    </FrameLayout>

    <!-- Last Updated Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp"
        android:padding="12dp"
        android:background="@drawable/info_box_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/last_updated"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/freshness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Just now"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/status_indicator"
            android:id="@+id/live_indicator" />
    </LinearLayout>

    <!-- Toggle Power Status Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_power_on"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="@string/power_on"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_power_on"
            android:textColor="@color/power_on_text" />

        <Button
            android:id="@+id/btn_power_off"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="@string/power_off"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_power_off"
            android:textColor="@color/power_off_text" />
    </LinearLayout>

    <!-- Pump Timer Button -->
    <Button
        android:id="@+id/btn_pump_timer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/pump_timer"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@color/accent"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="20dp" />

    <!-- Status Sync Progress -->
    <ProgressBar
        android:id="@+id/sync_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginTop="20dp" />

</LinearLayout>
